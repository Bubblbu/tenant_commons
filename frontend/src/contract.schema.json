    "Evidence": {
      "additionalProperties": false,
      "description": "Confirmed claims linking the network, by public source category:\nprovincial registry filings, City records (e.g. the SRO inventory naming\nthe person behind a company), and VTU research (everything else).",
      "properties": {
        "city_records": {
          "title": "City Records",
          "type": "integer"
        },
        "registry": {
          "title": "Registry",
          "type": "integer"
        },
        "vtu_research": {
          "title": "Vtu Research",
          "type": "integer"
        }
      },
      "required": [
        "registry",
        "city_records",
        "vtu_research"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Issues": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 1,
