# Byte-compiled / cached files
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/

# Tooling caches & reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
.hypothesis/

# Editor settings
.idea/
.vscode/
.~lock.*#

# Project-generated assets
www/
.preprocessed/
.uv-cache/

# Everything under data/ is ignored; only the README and per-source manifests
# are tracked. Membership exports are personal data — must never be committed.
data/**
!data/README.md
!data/**/
!data/**/MANIFEST.md
docs/disambiguation/*